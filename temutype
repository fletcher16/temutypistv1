<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Temutypist Developer Version</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;700&display=swap');

        * {
          box-sizing: border-box;
        }

        body {
          font-family: 'Roboto Mono', 'Courier New', Courier, monospace;
          background-color: #ff7208;
          color: #3d3d3d;
          display: flex;
          justify-content: center;
          align-items: center;
          min-height: 100vh;
          margin: 0;
          padding: 80px 20px 40px 20px;
          flex-direction: column;
          overflow-x: hidden;
        }

        /* Credits Banner */
        #credits-banner {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 34px;
            background: rgba(255, 114, 8, .85);
            border-top: 1px solid rgba(255,255,255,.15);
            overflow: hidden;
            z-index: 2147483646;
            pointer-events: none;
            display: flex;
            align-items: center;
        }

        #credits-banner span {
            white-space: nowrap;
            color: rgba(0, 0, 0, .9);
            font-family: Arial, Helvetica, sans-serif;
            font-size: 15px;
            font-weight: bold;
            padding-left: 100%;
            animation: creditsScroll 10s linear infinite;
        }

        #technology-watermark {
          position: fixed;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%) rotate(-45deg);
          color: #ffffff;
          opacity: 0.25;
          font-family: Arial, Helvetica, sans-serif;
          font-size: 5rem;
          font-weight: bold;
          white-space: nowrap;
          pointer-events: none;
          user-select: none;
          z-index: 0;
        }

        #news-ticker-container {
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 40px;
          background-color: #ff7208;
          border-bottom: 0px solid #d1d1d1;
          color: #3d3d3d;
          overflow: hidden;
          z-index: 100;
          display: flex;
          align-items: center;
        }

        #news-ticker-message {
          position: absolute;
          white-space: nowrap;
          font-size: 1em;
          font-weight: bold;
          will-change: transform;
          transform: translateX(100vw);
        }

        #news-ticker-message.scrolling {
          animation: scroll-left 60s linear;
        }

        #background-rain {
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          z-index: -1;
          overflow: hidden;
          pointer-events: none;
        }

        .raining-word {
          position: absolute;
          color: #ffffff;
          user-select: none;
          animation-name: fall;
          animation-timing-function: linear;
        }

        #game-container {
          width: 100%;
          max-width: 900px;
          text-align: center;
          position: relative;
          z-index: 1;
        }

        #total-score {
          font-size: 3.2em;
          border-radius: 67px;
          border: 5px solid #d1d1d1;
          color: #ffffff;
          font-weight: 700;
          background-color: #ff7208;
          padding: 5px 0;
          width: 100%;
          display: inline-block;
        }

        .score-popup {
          position: absolute;
          left: 50%;
          top: 60px;
          font-size: 1.5em;
          color: #005a9c;
          font-weight: bold;
          pointer-events: none;
          animation: float-up 2s ease-out forwards;
        }

        #typing-area {
          position: relative;
          width: 100%;
          font-size: 1.8em;
        }

        #text-to-type {
          background-color: #ff7208;
          padding: 25px;
          border-radius: 67px;
          border: 5px solid #fff;
          line-height: 1.6;
          min-height: 100px;
          cursor: text;
          transition: border-color 0.2s;
          white-space: pre-wrap;
          position: relative;
          z-index: 5;
        }

        #text-to-type.focused {
          border-color: #fff;
        }

        #typing-input {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          opacity: 0;
          z-index: 10;
          cursor: text;
          pointer-events: none;
        }

        #typing-input:focus {
          pointer-events: auto;
        }

        #cursor {
          background: #fff;
          width: 3px;
          height: 1.1em;
          border-radius: 0px;
          position: absolute;
          z-index: 5;
          transition: left 0.08s ease-out, top 0.08s ease-out;
          animation: blink 1s step-end infinite;
        }

        #cursor.solid {
          animation: none;
          background: #ffffff;
        }

        .word {
          display: inline-block;
          line-height: 1.6;
        }

        .char {
          position: relative;
          display: inline-block;
          color: #ffffff;
          transition: color 0.1s, background-color 0.1s;
        }

        .char.correct {
          color: #ffea00;
        }

        .char.incorrect {
          color: #c62828;
        }

        #test-info-container {
          display: flex;
          justify-content: space-between;
          align-items: center;
          width: 100%;
          margin-top: 10px;
          flex-wrap: wrap;
          gap: 10px;
        }

        .button-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .game-button {
          background-color: #fff;
          border: 1px solid #fff;
          border-radius: 5px;
          padding: 8px 12px;
          cursor: pointer;
          font-family: 'Roboto Mono', sans-serif;
          font-size: 0.9em;
          white-space: nowrap;
          transition: background-color 0.2s, border-color 0.2s;
        }

        .game-button:hover {
          background-color: #98989C;
        }

        .game-button.active {
            background-color: #e8f5e9;
            border-color: #2e9d32;
            font-weight: bold;
        }

        #test-results {
          font-size: 1.2em;
          color: #3d3d3d;
          font-weight: bold;
        }

        #upgrades-container {
          margin-top: 60px;
          width: 100%;
          position: relative;
          z-index: 1;
        }

        #upgrades-container h2 {
          font-size: 2em;
          margin-bottom: 5px;
          color: #3d3d3d;
        }

        #upgrades-container p {
          font-size: 1.1em;
          margin-bottom: 25px;
          color: #555;
        }

        .upgrade {
          text-align: left;
          background-color: #98989C;
          padding: 20px;
          margin-bottom: 15px;
          border-radius: 10px;
          border: 1px solid #fff;
          transition: all 0.2s ease-in-out;
          position: relative;
          z-index: 2;
        }

        .upgrade.buyable {
          cursor: pointer;
        }

        .upgrade.buyable:hover {
          transform: translateY(-3px);
          box-shadow: 0 6px 15px rgba(0, 0, 0, 0.12);
        }

        .upgrade.locked {
          opacity: 0.6;
          cursor: not-allowed;
        }

        .upgrade.purchased {
          background: linear-gradient(145deg, #e8f5e9, #d8f0d9);
          border-color: #fff;
          box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        .upgrade.hidden {
          display: none;
        }

        .upgrade-header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          font-weight: bold;
          font-size: 1.1em;
        }

        .upgrade-stats {
          font-size: 0.9em;
          margin-top: 10px;
          color: #6c757d;
          display: flex;
          flex-wrap: wrap;
          gap: 15px;
        }

        .upgrade-desc {
          font-size: 0.9em;
          margin-top: 10px;
          color: #6c757d;
        }

        .purchased .upgrade-desc {
          color: #1b5e20;
        }

        .level-badge {
          background-color: #005a9c;
          color: white;
          padding: 3px 10px;
          border-radius: 12px;
          font-size: 0.85em;
        }

        .modal-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 200;
            visibility: hidden;
            opacity: 0;
            transition: opacity 0.3s, visibility 0.3s;
        }

        .modal-backdrop.visible {
            visibility: visible;
            opacity: 1;
        }

        .modal {
            background-color: #fdfbf7;
            padding: 30px;
            border-radius: 10px;
            width: 90%;
            max-width: 600px;
            max-height: 80vh;
            overflow-y: auto;
            position: relative;
            transform: scale(0.9);
            transition: transform 0.3s;
            display: flex;
            flex-direction: column;
        }
        .modal-backdrop.visible .modal {
            transform: scale(1);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #d1d1d1;
            padding-bottom: 15px;
            margin-bottom: 15px;
        }

        .modal-header h2 {
            margin: 0;
            font-size: 1.8em;
        }

        .modal-close {
            font-size: 2em;
            font-weight: bold;
            cursor: pointer;
            background: none;
            border: none;
            color: #3d3d3d;
        }
        .modal-body {
            overflow-y: auto;
        }

        .changelog-entry, .status-section, .cheat-section {
            margin-bottom: 20px;
        }

        .changelog-entry h3, .status-section h3, .cheat-section h3 {
            margin: 0 0 10px 0;
            font-size: 1.3em;
            color: #005a9c;
        }

        .changelog-entry ul {
            list-style-type: disc;
            padding-left: 20px;
            margin: 0;
        }
        .changelog-entry li {
            margin-bottom: 5px;
        }

        #average-stats-display {
          font-size: 1.1em;
          font-weight: bold;
          margin-bottom: 15px;
        }
        #test-history-list {
          list-style-type: none;
          padding: 0;
          margin: 0;
        }
        #test-history-list li {
            background-color: #fff;
            border: 1px solid #e0e0e0;
            border-radius: 5px;
            padding: 10px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
        }
        #test-history-list .wpm { font-weight: bold; }

        .cheat-controls {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .cheat-controls .control-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .cheat-controls input {
            flex-grow: 1;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-family: 'Roboto Mono', monospace;
        }

        @keyframes blink {
          from, to { background-color: transparent; }
          50% { background-color: #2f9e33; }
        }

        @keyframes float-up {
          0% { transform: translate(-1%, 0); opacity: 1; }
          100% { transform: translate(-50%, -80px); opacity: 0; }
        }

        @keyframes fall {
          from { transform: translateY(-10vh) rotate(var(--start-rot)); }
          to { transform: translateY(110vh) rotate(var(--end-rot)); }
        }

        @keyframes scroll-left {
          from { transform: translateX(100vw); }
          to { transform: translateX(-100%); }
        }

        @keyframes creditsScroll {
          from { transform: translateX(0); }
          to { transform: translateX(-100%); }
        }
    </style>
</head>

