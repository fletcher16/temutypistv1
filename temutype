                type: 'passive',
                wpm: 900,
                wpmPerLevel: 45,
                accuracyRange: [1.00, 1.00],
                description: "Many employees"
            },
            {
                id: 'hivemind',
                name: 'large scale operation',
                baseCost: 40000000000,
                type: 'passive',
                wpm: 1500,
                wpmPerLevel: 75,
                accuracyRange: [1.00, 1.00],
                description: 'company now big'
            },
            {
                id: 'genie',
                name: 'more fast machines',
                baseCost: 676767000000,
                type: 'keyboard',
                multiplier: 45,
                description: "machines now go faster"
            },
            {
                id: 'realityeditor',
                name: 'the new big machine',
                baseCost: 150000000000,
                type: 'keyboard',
                multiplier: 125,
                description: "a new machine very fast and big"
            },
            {
                id: 'singularity',
                name: 'Xi Jinping',
                baseCost: 75000000000,
                type: 'passive',
                wpm: 3500,
                wpmPerLevel: 350,
                accuracyRange: [1.00, 1.00],
                description: 'xi jinping the supreme ruler'
            },
        ].map(u => ({ ...u,
            level: 0,
            costIncreaseFactor: 2.5
        }));
        const upgradeElements = {};

        function formatScore(score) {
            const truncateToTwoDecimals = (num) => Math.floor(num * 100) / 100;

            const format = (num, suffix) => {
                return truncateToTwoDecimals(num).toString() + suffix;
            };

            if (score >= 1_000_000_000_000_000_000) return format(score / 1_000_000_000_000_000_000, 'Qi');
            if (score >= 1_000_000_000_000_000) return format(score / 1_000_000_000_000_000, 'Q');
            if (score >= 1_000_000_000_000) return format(score / 1_000_000_000_000, 'T');
            if (score >= 1_000_000_000) return format(score / 1_000_000_000, 'B');
            if (score >= 1_000_000) return format(score / 1_000_000, 'M');
            if (score >= 1_000) return format(score / 1_000, 'K');

            return Math.floor(score).toLocaleString();
        }

        function generateText() {
            const wordCount = 12 + Math.floor(Math.random() * 5);
            currentText = Array.from({
                length: wordCount
            }, () => words[Math.floor(Math.random() * words.length)]).join(' ');
            startTest();
        }

        function renderText() {
            const typedText = typingInputEl.value;
            const typedLength = typedText.length;
            textToTypeEl.innerHTML = '';
            let charIndex = 0;
            const wordsInText = currentText.split(' ');
            wordsInText.forEach((word, wordIndex) => {
                const wordEl = document.createElement('span');
                wordEl.className = 'word';
                for (const char of word) {
                    const charEl = document.createElement('span');
                    charEl.className = 'char';
                    charEl.textContent = char;
                    if (charIndex < typedLength) {
                        charEl.classList.add(char === typedText[charIndex] ? 'correct' : 'incorrect');
                    }
                    wordEl.appendChild(charEl);
                    charIndex++;
                }
                textToTypeEl.appendChild(wordEl);
                if (wordIndex < wordsInText.length - 1) {
                    const spaceEl = document.createElement('span');
                    spaceEl.className = 'char';
                    spaceEl.innerHTML = ' ';
                    if (charIndex < typedLength) {
                        spaceEl.classList.add(typedText[charIndex] === ' ' ? 'correct' : 'incorrect');
                    }
                    textToTypeEl.appendChild(spaceEl);
                    charIndex++;
                }
            });
            updateCursorPosition();
        }

        function updateCursorPosition() {
            const typedLength = typingInputEl.value.length;
            const allCharSpans = textToTypeEl.querySelectorAll('.char');
            if (allCharSpans.length === 0) return;
            const containerRect = textToTypeEl.getBoundingClientRect();
            let targetChar = (typedLength < currentText.length) ? allCharSpans[typedLength] : allCharSpans[allCharSpans.length - 1];
            if (targetChar) {
                const charRect = targetChar.getBoundingClientRect();
                let cursorLeft = charRect.left - containerRect.left;
                if (typedLength >= currentText.length) {
                    cursorLeft += charRect.width;
                }
                const cursorTop = charRect.top - containerRect.top;
                cursorEl.style.left = `${cursorLeft}px`;
                cursorEl.style.top = `${cursorTop}px`;
                cursorEl.style.height = `${charRect.height}px`;
            }
        }

        function startTest() {
            typingInputEl.value = '';
            typingInputEl.maxLength = currentText.length;
            startTime = null;
            renderText();
        }

        function finishTest() {
            if (!startTime) return;
            const endTime = new Date();
            const timeDiff = (endTime - startTime) / 1000 / 60;
            let correctChars = 0;
            for (let i = 0; i < currentText.length; i++) {
                if (typingInputEl.value[i] === currentText[i]) correctChars++;
            }
            const cpm = timeDiff > 0 ? (correctChars / timeDiff) : 0;
            const finalWpm = Math.max(0, Math.round(cpm / 4.7));
            const accuracy = currentText.length > 0 ? (correctChars / currentText.length) : 0;
            const accuracyPercent = Math.round(accuracy * 100);
            const scoreGained = Math.round(((finalWpm * accuracyPercent) / 2) * 8 * scoreMultiplier);

            if (scoreGained > 0) {
                totalScore += scoreGained;
                showScorePopup(scoreGained);
            }

            testHistory.push({
                wpm: finalWpm,
                accuracy: accuracyPercent
            });
            testResultsEl.textContent = `${finalWpm} WPM | ${accuracyPercent}% Accuracy`;
            generateText();
        }

        function showScorePopup(score) {
            const popupEl = document.createElement('div');
            popupEl.className = 'score-popup';
            popupEl.textContent = `+${formatScore(score)}`;
            gameContainer.appendChild(popupEl);
            setTimeout(() => popupEl.remove(), 2000);
        }

        function initializeUpgrades() {
            upgradesListEl.innerHTML = '';
            upgrades.sort((a, b) => a.baseCost - b.baseCost).forEach(upgrade => {
                const isKeyboard = upgrade.type === 'keyboard';
                const levelBadgeHtml = isKeyboard ? '' : `<span class="level-badge" data-value-type="level">Lv. ${upgrade.level}</span>`;
                let statsHtml = '';
                if (upgrade.type === 'passive') {
                    statsHtml = `<div class="upgrade-stats"><span>WPM: <span data-value-type="wpm">0</span></span><span>Accuracy: <span data-value-type="accuracy">0%</span></span><span>SPS: <span data-value-type="sps">0.00</span></span></div>`;
                }
                const upgradeEl = document.createElement('div');
                upgradeEl.className = 'upgrade hidden';
                upgradeEl.dataset.id = upgrade.id;
                upgradeEl.innerHTML = `<div class="upgrade-header"><span class="upgrade-name">${upgrade.name} ${levelBadgeHtml}</span><span class="upgrade-cost" data-value-type="cost"></span></div>${statsHtml}<p class="upgrade-desc">${upgrade.description}</p>`;
                upgradesListEl.appendChild(upgradeEl);
                upgradeElements[upgrade.id] = upgradeEl;
            });
        }

        function updateUpgrades() {
            let showNext = true;
            for (const upgrade of upgrades) {
                const upgradeEl = upgradeElements[upgrade.id];
                if (!upgradeEl) continue;
                if (!showNext && upgrade.level === 0) {
                    upgradeEl.classList.add('hidden');
                    continue;
                }

                upgradeEl.classList.remove('hidden');
                if (upgrade.level === 0) {
                    showNext = false;
                }

                const isKeyboard = upgrade.type === 'keyboard';
                let isMaxLevel = isKeyboard ? upgrade.level >= 1 : upgrade.level >= 99;
                if (upgrade.id === 'monkey' && upgrade.level >= 2) {
                    isMaxLevel = true;
                }

                let cost = Math.ceil(upgrade.baseCost * Math.pow(upgrade.costIncreaseFactor, upgrade.level));
                if (upgrade.id === 'monkey' && upgrade.level === 1) {
                    cost = 10000000000000;
                }

                const canAfford = totalScore >= cost;
                upgradeEl.classList.toggle('buyable', canAfford && !isMaxLevel);
                upgradeEl.classList.toggle('locked', !canAfford || isMaxLevel);
                upgradeEl.classList.toggle('purchased', isKeyboard && isMaxLevel);

                if (upgrade.id === 'monkey') {
                    upgradeEl.querySelector('.upgrade-name').innerHTML = `${upgrade.name} <span class="level-badge" data-value-type="level">Lv. ${upgrade.level}</span>`;
                    upgradeEl.querySelector('.upgrade-desc').textContent = upgrade.description;
                }

                const costEl = upgradeEl.querySelector('[data-value-type="cost"]');
                if (costEl) {
                    if (isMaxLevel && (isKeyboard || upgrade.id === 'monkey')) {
                        costEl.textContent = 'Active';
                    } else if (upgrade.id === 'monkey' && upgrade.level >= 2) {
                        costEl.textContent = 'Active';
                    } else {
                        costEl.textContent = `Cost: ${formatScore(cost)}`;
                    }
                }

                if (!isKeyboard) {
                    const levelEl = upgradeEl.querySelector('[data-value-type="level"]');
                    if (levelEl) levelEl.textContent = `Lv. ${upgrade.level}`;
                    const currentWpm = upgrade.wpm + (upgrade.level * upgrade.wpmPerLevel);
                    const avgAccuracy = ((upgrade.accuracyRange[0] + upgrade.accuracyRange[1]) / 2) * 100;
                    const sps = calculateSPSForUpgrade(upgrade);

                    let nextWpmText = '';
                    if (!isMaxLevel) {
                        if (upgrade.id === 'monkey' && upgrade.level === 1) {} else {
                            nextWpmText = ` (Next: ${currentWpm + upgrade.wpmPerLevel})`;
                        }
                    }

                    upgradeEl.querySelector('[data-value-type="wpm"]').textContent = `${currentWpm}${nextWpmText}`;
                    upgradeEl.querySelector('[data-value-type="accuracy"]').textContent = `${avgAccuracy.toFixed(0)}%`;
                    upgradeEl.querySelector('[data-value-type="sps"]').textContent = sps.toFixed(0);
                }
            };
        }

        function buyUpgrade(upgrade) {
            let cost = Math.ceil(upgrade.baseCost * Math.pow(upgrade.costIncreaseFactor, upgrade.level));
            if (upgrade.id === 'monkey' && upgrade.level === 1) {
                cost = 100000000;
            }
            if (totalScore < cost) return;
            totalScore -= cost;
            upgrade.level++;
            if (upgrade.id === 'monkey' && upgrade.level === 1) {
                upgrade.name = 'Mass hiring of children';
                upgrade.description = "A children monkeys... a million keyboards. The brainrot will begin. Will they write skibidi toilet?";
                upgrade.wpm = 50000;
                upgrade.wpmPerLevel = 0;
                upgrade.accuracyRange = [0.20, 0.70];
            }
            if (upgrade.id === 'monkey' && upgrade.level === 2) {
                newsQueue.push("BREAKING NEWS: Global monkey population surges! Experts blame a single, powerful typist. It's a monkeypocalypse! STOP STEALING THEM");
                processNewsQueue();
            }

            if (upgrade.type === 'keyboard') recalculateMultiplier();
            else recalculateSPS();
        }

        function recalculateMultiplier() {
            let baseMultiplier = upgrades.reduce((mult, up) => {
                if (up.type === 'keyboard' && up.level > 0) return mult * up.multiplier;
                return mult;
            }, 1);

            if (scoreMultiplier !== baseMultiplier && hasCheated) {
                // Keep the cheated multiplier
            } else {
                scoreMultiplier = baseMultiplier;
            }

            multiplierEl.textContent = `${scoreMultiplier}x`;
        }

        function calculateSPSForUpgrade(up) {
            if (up.type !== 'passive' || up.level === 0) return 0;

            if (up.id === 'monkey' && up.level >= 2) {
                const currentWpm = up.wpm;
                const avgAccuracy = (up.accuracyRange[0] + up.accuracyRange[1]) / 2;
                const scaledWpm = Math.pow(currentWpm, 1.2);
                const scorePerTest = (scaledWpm * (avgAccuracy * 100)) / 10;
                const charsPerTest = 50;
                if (currentWpm === 0) return 0;
                const timePerTest = (charsPerTest / 5 / currentWpm) * 60;
                return scorePerTest / timePerTest;
            }

            if (up.id === 'monkey' && up.level === 1) {
                const originalMonkeyWpm = 10;
                const originalMonkeyAccuracy = (0.05 + 0.10) / 2;
                const scaledWpm = Math.pow(originalMonkeyWpm, 1.2);
                const scorePerTest = (scaledWpm * (originalMonkeyAccuracy * 100)) / 10;
                const charsPerTest = 50;
                const timePerTest = (charsPerTest / 5 / originalMonkeyWpm) * 60;
                return scorePerTest / timePerTest;
            }

            const currentWpm = up.wpm + ((up.level - 1) * up.wpmPerLevel);
            const avgAccuracy = (up.accuracyRange[0] + up.accuracyRange[1]) / 2;
            const scaledWpm = Math.pow(currentWpm, 1.2);
            const scorePerTest = (scaledWpm * (avgAccuracy * 100)) / 10;
            const charsPerTest = 50;
            if (currentWpm === 0) return 0;
            const timePerTest = (charsPerTest / 5 / currentWpm) * 60;
            return (scorePerTest / timePerTest) * up.level;
        }

        function recalculateSPS() {
            scorePerSecond = upgrades.reduce((totalSps, up) => {
                return totalSps + calculateSPSForUpgrade(up);
            }, 0);
            spsEl.textContent = scorePerSecond.toFixed(0);
            checkNewsTriggers();
        }

        function checkNewsTriggers() {
            newsMessages.forEach(msg => {
                if (!msg.triggered && scorePerSecond >= msg.spsThreshold) {
                    msg.triggered = true;
                    newsQueue.push(msg.message);
                }
            });
            processNewsQueue();
        }

        function executeCheat(cheatFunction) {
            if (!hasCheated) {
                hasCheated = true;
                processNewsQueue();
            }
            cheatFunction();
        }

        function processNewsQueue() {
            if (isTickerActive || newsQueue.length === 0) {
                return;
            }
            isTickerActive = true;
            const message = newsQueue.shift();
            newsTickerMessageEl.textContent = message;
            newsTickerMessageEl.classList.add('scrolling');
        }

        function saveGame() {
            const gameState = {
                totalScore: totalScore,
                upgrades: upgrades.map(u => ({
                    id: u.id,
                    level: u.level,
                    ...(u.id === 'monkey' && u.level > 0 && {
                        name: u.name,
                        description: u.description,
                        wpm: u.wpm,
                        wpmPerLevel: u.wpmPerLevel,
                        accuracyRange: u.accuracyRange
                    })
                })),
                newsTriggers: newsMessages.map(n => n.triggered),
                testHistory: testHistory,
                hasCheated: hasCheated,
                scoreMultiplier: scoreMultiplier,
                isHyperSpeedActive: isHyperSpeedActive
            };
            localStorage.setItem('idleTypistSave', JSON.stringify(gameState));
        }

        function loadGame() {
            const savedStateJSON = localStorage.getItem('idleTypistSave');
            if (!savedStateJSON) return;
            try {
                const savedState = JSON.parse(savedStateJSON);
                totalScore = savedState.totalScore || 0;
                testHistory = savedState.testHistory || [];
                hasCheated = savedState.hasCheated || false;
                isHyperSpeedActive = savedState.isHyperSpeedActive || false;

                if (hasCheated) {
                    scoreMultiplier = savedState.scoreMultiplier || 1;
                }

                if (savedState.upgrades) {
                    savedState.upgrades.forEach(savedUpgrade => {
                        const gameUpgrade = upgrades.find(u => u.id === savedUpgrade.id);
                        if (gameUpgrade) {
                            gameUpgrade.level = savedUpgrade.level || 0;
                            if (savedUpgrade.id === 'monkey' && savedUpgrade.level > 0) {
                                gameUpgrade.name = savedUpgrade.name;
                                gameUpgrade.description = savedUpgrade.description;
                                gameUpgrade.wpm = savedUpgrade.wpm;
                                gameUpgrade.wpmPerLevel = savedUpgrade.wpmPerLevel;
                                gameUpgrade.accuracyRange = savedUpgrade.accuracyRange;
                            }
                        }
                    });
                }
                if (savedState.newsTriggers) {
                    savedState.newsTriggers.forEach((triggered, index) => {
                        if (newsMessages[index]) {
                            newsMessages[index].triggered = triggered;
                        }
                    });
                }
            } catch (e) {
                console.error("Failed to load saved game:", e);
            }
        }

        function createRainingWord() {
            if (!backgroundRainEl) return;
            const wordEl = document.createElement('div');
            wordEl.className = 'raining-word';
            wordEl.textContent = words[Math.floor(Math.random() * words.length)];
            const duration = 8 + Math.random() * 10;
            const startRotation = Math.random() * 60 - 30;
            const endRotation = startRotation + Math.random() * 40 - 20;
            wordEl.style.left = `${Math.random() * 100}vw`;
            wordEl.style.fontSize = "1.2em";
            wordEl.style.opacity = "0.5";
            wordEl.style.setProperty('--start-rot', `${startRotation}deg`);
            wordEl.style.setProperty('--end-rot', `${endRotation}deg`);
            wordEl.style.animationDuration = `${duration}s`;
            backgroundRainEl.appendChild(wordEl);
            wordEl.addEventListener('animationend', () => {
                wordEl.remove();
            });
        }

        function rainEffectLoop() {
            const cappedSps = Math.min(scorePerSecond, 1000);
            const wordsPerSecond = 0.2 + (cappedSps / 1000) * 15;
            const spawnInterval = 1000 / wordsPerSecond;
            if (scorePerSecond > 0 || hasCheated) {
                createRainingWord();
            }
            rainTimeoutId = setTimeout(rainEffectLoop, spawnInterval);
        }

        function openStatusModal() {
            const avgDisplay = document.getElementById('average-stats-display');
            const historyList = document.getElementById('test-history-list');

            if (testHistory.length === 0) {
                avgDisplay.textContent = 'No tests completed yet.';
                historyList.innerHTML = '<li>Complete a typing test to see your history!</li>';
            } else {
                const totalWpm = testHistory.reduce((sum, test) => sum + test.wpm, 0);
                const totalAccuracy = testHistory.reduce((sum, test) => sum + test.accuracy, 0);
                const avgWpm = (totalWpm / testHistory.length).toFixed(0);
                const avgAccuracy = (totalAccuracy / testHistory.length).toFixed(0);
                avgDisplay.textContent = `Average: ${avgWpm} WPM | ${avgAccuracy}% Accuracy`;

                const sortedHistory = [...testHistory].sort((a, b) => b.wpm - a.wpm);
                historyList.innerHTML = sortedHistory.map((test, index) =>
                    `<li>
                    <span>#${index + 1}</span>
                    <span class="wpm">${test.wpm} WPM</span>
                    <span class="accuracy">${test.accuracy}% Acc</span>
                </li>`
                ).join('');
            }
            statusModal.classList.add('visible');
        }

        function setupEventListeners() {
            typingInputEl.addEventListener('focus', () => {
                textToTypeEl.classList.add('focused');
                cursorEl.classList.add('solid');
            });
            typingInputEl.addEventListener('blur', () => {
                textToTypeEl.classList.remove('focused');
                cursorEl.classList.remove('solid');
            });
            typingInputEl.addEventListener('input', () => {
                if (!startTime && typingInputEl.value.length > 0) {
                    startTime = new Date();
                }
                renderText();
                if (typingInputEl.value.length >= currentText.length) {
                    finishTest();
                }
            });
            upgradesListEl.addEventListener('click', (e) => {
                const upgradeEl = e.target.closest('.upgrade.buyable');
                if (!upgradeEl) return;
                const upgradeId = upgradeEl.dataset.id;
                const upgrade = upgrades.find(u => u.id === upgradeId);
                if (upgrade) {
                    buyUpgrade(upgrade);
                }
            });
            window.addEventListener('resize', updateCursorPosition);

            newsTickerMessageEl.addEventListener('animationend', () => {
                newsTickerMessageEl.classList.remove('scrolling');
                isTickerActive = false;
                processNewsQueue();
            });

            newTextButton.addEventListener('click', () => {
                generateText();
                typingInputEl.focus();
            });

            hyperSpeedButton.addEventListener('click', () => {
                isHyperSpeedActive = !isHyperSpeedActive;
                hyperSpeedButton.classList.toggle('active', isHyperSpeedActive);
            });

            resetButton.addEventListener('click', () => {
                if (confirm("Are you sure you want to reset all your progress? This cannot be undone.")) {
                    localStorage.removeItem('idleTypistSave');
                    location.reload();
                }
            });

            changelogButton.addEventListener('click', () => changelogModal.classList.add('visible'));
            statusButton.addEventListener('click', openStatusModal);
            cheatButton.addEventListener('click', () => cheatModal.classList.add('visible'));

            fullscreenButton.addEventListener('click', () => {
                window.open(window.location.href, '_blank');
            });

            allModals.forEach(modal => {
                modal.addEventListener('click', (e) => {
                    if (e.target.classList.contains('modal-backdrop') || e.target.classList.contains('modal-close')) {
                        modal.classList.remove('visible');
                    }
                });
            });

            // Cheat Listeners
            addScoreButton.addEventListener('click', () => {
                executeCheat(() => {
                    const amount = parseInt(addScoreInput.value, 10);
                    if (!isNaN(amount) && amount > 0) {
                        totalScore += amount;
                        addScoreInput.value = '';
                    }
                });
            });
            addMassiveScoreButton.addEventListener('click', () => {
                executeCheat(() => {
                    totalScore += 1_000_000_000_000_000;
                });
            });
            setMultiplierButton.addEventListener('click', () => {
                executeCheat(() => {
                    const newMult = parseInt(setMultiplierInput.value, 10);
                    if (!isNaN(newMult) && newMult > 0) {
                        scoreMultiplier = newMult;
                        multiplierEl.textContent = `${scoreMultiplier}x`;
                        setMultiplierInput.value = '';
                    }
                });
            });
            buyAllUpgradesButton.addEventListener('click', () => {
                executeCheat(() => {
                    upgrades.forEach(u => {
                        if (u.type === 'keyboard') u.level = 1;
                        else if (u.id === 'monkey') u.level = 2;
                        else u.level = 99;
                    });
                    recalculateMultiplier();
                    recalculateSPS();
                    updateUpgrades();
                });
            });

        }

        function gameLoop() {
            totalScoreEl.textContent = `Score: ${formatScore(totalScore)}`;
            updateUpgrades();
            requestAnimationFrame(gameLoop);
        }
        window.onload = () => {
            loadGame();
            generateText();
            initializeUpgrades();
            recalculateSPS();
            recalculateMultiplier();
            hyperSpeedButton.classList.toggle('active', isHyperSpeedActive);
            setupEventListeners();
            requestAnimationFrame(gameLoop);
            rainEffectLoop();
            typingInputEl.focus();
            setInterval(() => {
                if (scorePerSecond > 0) {
                    const speedMultiplier = isHyperSpeedActive ? 6 : 1;
                    totalScore += (scorePerSecond / 10) * speedMultiplier;
                }
            }, 100);
            setInterval(saveGame, 10000);
        };
    </script>
